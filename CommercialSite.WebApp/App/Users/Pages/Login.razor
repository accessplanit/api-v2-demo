@page "/login"
@layout LoginLayout

@inject NavigationManager NavigationManager
@inject StateManagementService StateManagementService
@inject AccessPlanitTokenClient AccessPlanitTokenClient
@inject AccessPlanitAPIClient AccessPlanitAPIClient
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AccessPlanitLoginClient AccessPlanitLoginClient
@inject AccessPlanitAPIBasketClient basketClient

<PageTitle>Sign in</PageTitle>

<div class="login-card">
    @if (Reason == "timeout")
    {
        <div class="login-notice" role="status">You were signed out because of inactivity. Sign in to continue.</div>
    }

    <EditForm Model="LoginFormModel" OnValidSubmit="HandleLogin" FormName="LoginForm">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label for="Username" class="login-label">Username</label>
            <div class="login-input">
                <i class="lni lni-user"></i>
                <InputText id="Username" placeholder="Username" autocomplete="username" autofocus @bind-Value="LoginFormModel.Username" disabled="@IsLoggingIn" />
            </div>
            <ValidationMessage For="@(() => LoginFormModel.Username)" class="login-validation" />
        </div>

        <div class="mb-3">
            <label for="Password" class="login-label">Password</label>
            <div class="login-input">
                <i class="lni lni-lock-alt"></i>
                <InputText type="@(ShowPassword ? "text" : "password")" id="Password" placeholder="Password" autocomplete="current-password" @bind-Value="LoginFormModel.Password" disabled="@IsLoggingIn" />
                <button type="button" class="login-toggle" aria-label="@(ShowPassword ? "Hide password" : "Show password")" @onclick="() => ShowPassword = !ShowPassword">
                    <i class="lni @(ShowPassword ? "lni-eye-slash" : "lni-eye")"></i>
                </button>
            </div>
            <ValidationMessage For="@(() => LoginFormModel.Password)" class="login-validation" />
        </div>

        @if (!string.IsNullOrEmpty(ApiErrorMessage))
        {
            <div class="login-error" role="alert">@ApiErrorMessage</div>
        }

        <button class="login-button" type="submit" disabled="@IsLoggingIn">
            @if (IsLoggingIn)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span>Signing in...</span>
            }
            else
            {
                <span>Sign in</span>
            }
        </button>
    </EditForm>
</div>

@code {
    private LoginForm? LoginFormModel { get; set; }

    [SupplyParameterFromQuery(Name = "reason")]
    public string? Reason { get; set; }

    private bool IsLoggingIn = false;
    private bool ShowPassword = false;
    private string ApiErrorMessage = "";

    protected override void OnInitialized() => LoginFormModel ??= new();
    
    private async Task HandleLogin()
    {
        IsLoggingIn = true;
        ApiErrorMessage = "";

        try
        {

            var token = await AccessPlanitTokenClient.GetToken();

            if (token is not null)
                await ((ApiAuthenticationStateProvider)AuthenticationStateProvider).MarkUserAsAuthenticated(token);

            var loginResponse = await AccessPlanitLoginClient.Login(LoginFormModel);

            if (loginResponse.Success)
            {
                var user = await AccessPlanitAPIClient.GetById<User>(loginResponse.User.ID);

                if (user is not null){
                    user.ID = loginResponse.User.ID;
                    StateManagementService.SetLoggedInUser(user);
                    await StateManagementService.PersistUserIdAsync(user.ID);
                    StateManagementService.Basket = await basketClient.GetBasketForUser(user.ID);
                }

                // Navigate to the homepage after successful login
                NavigationManager.NavigateTo("/");
            }
            else
            {
                ApiErrorMessage = loginResponse.Message;
                StateManagementService.Logout();
                await ((ApiAuthenticationStateProvider)AuthenticationStateProvider).MarkUserAsLoggedOut();
                NavigationManager.NavigateTo("/login");
            }
        }
        catch (Exception ex)
        {
            StateManagementService.SetLatestErrorMessage($"Error logging in: {ex.Message}");
        }

        LoginFormModel.Password = string.Empty;
        IsLoggingIn = false;
    }
}
