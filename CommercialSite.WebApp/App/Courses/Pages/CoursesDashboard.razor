@page "/courses";
@inject AccessPlanitCourseClient AccessPlanitCourseClient;
@inject AccessPlanitCourseDateClient AccessPlanitCourseDateClient;
@inject AccessPlanitUserCourseDateClient AccessPlanitUserCourseDateClient;
@inject AccessPlanitAPIBasketClient BasketClient;
@inject StateManagementService StateManagementService;

<div class="toast course-added-toast align-items-center" role="alert" aria-live="assertive" aria-atomic="true" data-bs-autohide="true">
    <div class="d-flex">
        <div class="toast-body">
            Course added to basket successfully.
        </div>
        <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
</div>

@if (courses == null)
{
    <p>Loading...</p>
}
else
{

    <div class="d-flex flex-column mt-2">
        <div>
            <div class="filter rounded d-flex flex-row flex-wrap">
                <div class="me-3 my-3 flex-grow-1 course-search">
                    <label for="course-search" class="mb-1">Course</label>
                    <div class="search-box">
                        <div class="search-box-icon" />
                        <input id="course-search" type="search" autofocus @oninput="OnLabelFilterChanged" placeholder="Search...">
                    </div>
                </div>
                @* <div class="divider"></div> *@
                <div class="me-3 my-3">
                    <label for="coursetype-filter" class="mb-1">Course Type</label>
                    <select id="coursetype-filter" class="coursetype-filter" @onchange="OnCourseTypeFilterChanged">
                        <option value="">-- Select --</option>
                        <option value="class">Class</option>
                        <option value="elearning">ELearning</option>
                        <option value="web">Web</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="d-flex flex-column my-3">
            @foreach (var course in filteredCourses)
            {
                <div class="d-flex border rounded flex-column my-3 course-card">
                    <div class="d-flex justify-content-between p-4 w-100 gap-5">
                        <div class="d-flex flex-column">
                            <div class="d-flex flex-row align-items-center pb-1">
                                <div class="fw-bold fs-4">
                                    @course.Label
                                </div>
                                <div class="classtype-tag rounded fs-7 @GetCourseTypeStyle(course.CourseType)" style="margin-left: 8px;">
                                    <i class="bi @GetCourseIcon(course.CourseType)"></i>
                                    @course.CourseType
                                </div>
                            </div>
                            <div class="text-justify pb-3">
                                @((MarkupString)course.Description)
                            </div>
                            <div>
                                <button class="btn @(visibleGrids.ContainsKey(course.ID) && visibleGrids[course.ID] ? "btn-secondary" : "btn-primary")" @onclick="() => ToggleGridVisibility(course.ID)">
                                    @if (visibleGrids.ContainsKey(course.ID) && visibleGrids[course.ID])
                                    {
                                        <text>Hide Dates</text>
                                    }
                                    else
                                    {
                                        <text>Show Dates</text>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>

                    @if (visibleGrids.ContainsKey(course.ID) && visibleGrids[course.ID])
                    {
                        <div class="p-4 pt-0 w-100">
                            <QuickGrid Items="filteredCourseDates.Where(cd => cd.CourseID == course.ID)" Pagination="@GetPaginationState(course.ID)" style="width: 100%">
                                <PropertyColumn Property="@(d => d.StartDate)" Title="Start Date" Sortable="true" />
                                <PropertyColumn Property="@(d => d.EndDate)" Title="End Date" Sortable="true" />
                                <PropertyColumn Property="@(d => Math.Round(d.DurationInHours, 1))" Title="Hours" Sortable="true" />
                                <PropertyColumn Property="@(d => d.Status)" Title="Status" Sortable="true" />
                                <PropertyColumn Property="@(d => d.DisplayCost)" Title="Cost" Sortable="true" />
                                <PropertyColumn Property="@(d => d.VenueLabel)" Title="Venue" Sortable="true" />
                                <PropertyColumn Property="@(d => d.VenueTown)" Title="Town" Sortable="true" />
                                <PropertyColumn Property="@(d => d.SpacesLeft)" Title="Places" Sortable="true" />
                                <TemplateColumn Class="right-align">
                                    <button class="@($"btn {(context.SpacesLeft < 1 ? "btn-danger" : "btn-success")}")" disabled="@((context.SpacesLeft < 1))" @onclick="() => AddItemToBasket(context.ID)">
                                        @(context.SpacesLeft < 1 ? "Unavailable" : "Book")
                                    </button>
                                </TemplateColumn>
                            </QuickGrid>
                            <Paginator State="@GetPaginationState(course.ID)" />
                        </div>
                    }
                </div>
            }
        </div>

    </div>
}

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    PaginationState pagination = new PaginationState { ItemsPerPage = 5 };
    Dictionary<string, PaginationState> paginationStates = new();
    IQueryable<Course>? courses;
    IQueryable<Course>? filteredCourses;
    IQueryable<CourseDate>? courseDates;
    IQueryable<CourseDate>? filteredCourseDates;
    private Dictionary<Course, bool> ExpandedRows = new Dictionary<Course, bool>();
    private Dictionary<string, bool> visibleGrids = new();
    private string currentLabelFilter = string.Empty;
    private string currentCourseTypeFilter = string.Empty;

    private void ToggleGridVisibility(string courseId)
    {
        if (!visibleGrids.ContainsKey(courseId))
            visibleGrids[courseId] = false;

        visibleGrids[courseId] = !visibleGrids[courseId];
    }

    private PaginationState GetPaginationState(string courseId)
    {
        if (!paginationStates.TryGetValue(courseId, out var state) || state is null)
        {
            state = new PaginationState() { ItemsPerPage = 5 };
            paginationStates[courseId] = state;
        }

        return state;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var courseResult = await AccessPlanitCourseClient.GetAll<Course>();
            courses = (courseResult ?? new List<Course>()).AsQueryable();
            filteredCourses = courses;

            var courseDateResult = await AccessPlanitCourseDateClient.GetAll<CourseDate>();
            courseDates = (courseDateResult ?? new List<CourseDate>()).AsQueryable();
            filteredCourseDates = courseDates;
        }
        catch (Exception ex)
        {
            StateManagementService.SetLatestErrorMessage($"Something went wrong: {ex.Message}");
            throw;
        }
    }

    private void ToggleRow(Course course)
    {
        if (!ExpandedRows.ContainsKey(course))
            ExpandedRows[course] = false;

        ExpandedRows[course] = !ExpandedRows[course];
    }

    private bool GetRowExpanded(Course course)
        => ExpandedRows.ContainsKey(course) && ExpandedRows[course];

    private async Task AddItemToBasket(string itemID)
    {
        StateManagementService.Basket = await BasketClient.AddItemToBasket(StateManagementService.LoggedInUser.ID, itemID, 12);

        StateHasChanged();

        await JS.InvokeVoidAsync("showAddItemToast");
    }

    private async Task SearchCoursesByLabel(string searchLabel)
    {
        currentLabelFilter = searchLabel;

        await ApplyFilters();
    }

    private async Task SearchCoursesByCourseType(string courseType)
    {
        currentCourseTypeFilter = courseType;

        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        if (string.IsNullOrWhiteSpace(currentLabelFilter) && string.IsNullOrWhiteSpace(currentCourseTypeFilter))
        {
            filteredCourses = courses;
        }
        else
        {
            var coursesResult = await AccessPlanitCourseClient.GetFilteredCourses(
                label: string.IsNullOrWhiteSpace(currentLabelFilter) ? null : currentLabelFilter,
                courseType: string.IsNullOrWhiteSpace(currentCourseTypeFilter) ? null : currentCourseTypeFilter
            );

            var courseDates = new List<CourseDate>();

            foreach(var course in coursesResult)
            {
                var courseDateResult = await AccessPlanitCourseDateClient.GetCourseDatesForCourseId(course.ID);
                courseDates.AddRange(courseDateResult);
            }

            filteredCourses = coursesResult?.AsQueryable();
            filteredCourseDates = courseDates?.AsQueryable();
        }

        StateHasChanged();
    }

    private async void OnLabelFilterChanged(ChangeEventArgs e)
        => await SearchCoursesByLabel(e.Value.ToString());
    
    private async void OnCourseTypeFilterChanged(ChangeEventArgs e)
        => SearchCoursesByCourseType(e.Value.ToString());  

    private string GetCourseTypeStyle(string courseType)
    {
        return courseType switch
        {
            "ELearning" => "elearning-tag",
            "Class" => "class-tag",
            "Web" => "web-tag",
            _ => ""
        };
    }

    private string GetCourseIcon(string courseType)
    {
        return courseType switch
        {
            "ELearning" => "bi-laptop",
            "Class" => "bi-building",
            "Web" => "bi-globe",
            _ => ""
        };
    }
}

<script type="text/javascript">
    function showAddItemToast(){
        var toastElList = [].slice.call(document.querySelectorAll('.course-added-toast'))
        var toastList = toastElList.map(function (toastEl) {
            return new bootstrap.Toast(toastEl)
        });

        toastList.forEach(function (toast) {
            toast.show();
        });
    }
</script>

