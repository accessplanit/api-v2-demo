        font-size:0.8rem;
    }

    .basket-item-discount{
        font-size:0.8rem;
        padding-top:5px;
        font-weight:bold;
        color:red;
    }

    .basket-item-user{
        font-size: 0.8rem;
        padding-top: 5px;
    }

    .cart-body {
        padding: 10px;
    }

    .checkout-button{
        width:100%;
    }

