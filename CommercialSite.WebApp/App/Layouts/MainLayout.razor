@using CommercialSite.WebApp.App.SharedComponents;

@inherits LayoutComponentBase
@inject StateManagementService StateManagementService
@inject AccessPlanitAPIClient AccessPlanitAPIClient
@inject AccessPlanitAPIBasketClient BasketClient


<div id="main-layout">
    <div id="sidebar-content">
        <SideNavBar />
    </div>
    <div id="main-content">
        <div id="header" class="mx-4">
            <CascadingValue Value="IsLoggedIn">
                <HeaderNavBar/>
            </CascadingValue>
        </div>
        <div id="content" class="m-4">
            <ErrorBanner />
            @if (sessionChecked)
            {
                @Body
            }
        </div>
        <CommercialSite.WebApp.App.Basket.ShoppingBasket/>
    </div>
</div>

@code {

    public bool IsLoggedIn { get; set; }

    private bool sessionChecked;

    protected override async Task OnInitializedAsync()
    {
        await RestoreSessionAsync();

        IsLoggedIn = StateManagementService.IsLoggedIn;
        sessionChecked = true;
    }

    // A reload starts a new circuit with empty state, so rebuild the user from the saved ID
    // before any page renders and reads it.
    private async Task RestoreSessionAsync()
    {
        if (StateManagementService.IsLoggedIn)
            return;

        try
        {
            var userId = await StateManagementService.GetPersistedUserIdAsync();

            if (string.IsNullOrEmpty(userId))
                return;

            var user = await AccessPlanitAPIClient.GetById<User>(userId);

            if (user is null)
            {
                await StateManagementService.ClearPersistedUserIdAsync();
                return;
            }

            user.ID = userId;
            StateManagementService.SetLoggedInUser(user);
            StateManagementService.Basket = await BasketClient.GetBasketForUser(userId);
        }
        catch (Exception ex)
        {
            StateManagementService.SetLatestErrorMessage($"Could not restore your session: {ex.Message}");
        }
    }
}





